{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/enforce-venv.sh",
        "matcher": "Shell"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-main-push.sh",
        "matcher": "git push",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/audit.sh"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/no-console-log.sh",
        "matcher": "Write"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/audit.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/audit.sh"
      }
    ]
  }
}
